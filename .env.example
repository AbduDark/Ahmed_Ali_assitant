# ============================================================
# AI Teacher Assistant - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to source control
# ============================================================

# --- Application ---
APP_ENV=production
APP_NAME="AI Teacher Assistant"
DOMAIN_NAME=assistant.192.99.144.235.nip.io
APP_URL=https://assistant.192.99.144.235.nip.io
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://teacher_ai:teacher_ai_pass@postgres:5432/teacher_ai_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://assistant.192.99.144.235.nip.io
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-random-secret
TELEGRAM_USE_POLLING=false

# --- AI Providers ---
# Active provider: gemini, groq, openrouter, openai
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,openrouter

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG Configuration ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=75

# --- Rate Limiting ---
RATE_LIMIT_STUDENT_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# --- File Upload ---
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://assistant.192.99.144.235.nip.io
